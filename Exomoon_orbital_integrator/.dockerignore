# Exclude large data and cache files from build context.
# Build context root: Exomoon_orbital_integrator/
# ** is required for subdirectory matching.

# Large data files
**/*.parquet
**/*.csv
**/*.html
**/*.png
**/*.log
**/*.npy
**/*.nbc
**/*.nbi

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Model directories NOT needed for HNN inference
src/models/
src/models_temphead/
src/models_temphead_ss/
src/models_temphead_ss_prefix/
src/models_logfix/
src/models_hnn_hill_hinge1/
src/models_hnn_hill_hinge2/
src/models_hnn_hill_hinge3/
src/models_hnn_hill_hinge5/
src/models_hnn_hill_hinge6/
src/models_hnn_hill_hinge7/
src/models_hnn_hill_hinge8/
src/models_hnn_log/
src/eval_*/

# Ground truth grids (test-only)
src/ground_truth_grids/

# Project infra files not needed inside container
*.sh
*.yaml
*.yml
Dockerfile
*.Dockerfile
